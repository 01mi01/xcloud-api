# AWS Cognito User Pool ID (found in Cognito console)
COGNITO_USER_POOL_ID=

# AWS Cognito App Client ID (found in App clients section)
COGNITO_CLIENT_ID=

# AWS Cognito App Client Secret (found in App clients section)
COGNITO_CLIENT_SECRET=

# AWS region where your Cognito User Pool is deployed e.g. us-east-2
AWS_REGION=

# Port where the auth service will run e.g. 3000
PORT=3000

# Port where the user service will run
USER_SERVICE_PORT=3001

# Local JWT secret (used instead of Cognito during local dev)
JWT_SECRET=xcloud-local-dev-secret

# Cassandra (Docker local dev — Amazon Keyspaces in production)
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_DC=datacenter1
CASSANDRA_KEYSPACE=xcloud

# PostgreSQL connection (Docker local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xcloud
DB_USER=postgres
DB_PASSWORD=postgres
