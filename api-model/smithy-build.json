{
  "version": "1.0",
  "sources": ["model"],
  "maven": {
    "dependencies": [
      "software.amazon.smithy:smithy-openapi:1.50.0",
      "software.amazon.smithy:smithy-aws-traits:1.50.0",
      "software.amazon.smithy.typescript:smithy-typescript-codegen:0.31.1",
      "software.amazon.smithy.typescript:smithy-aws-typescript-codegen:0.31.1"
    ]
  },
  "projections": {
