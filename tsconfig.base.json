{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@xcloud/shared": ["./packages/shared/src/index.ts"],
      "@xcloud/sdk-client": ["./packages/sdk-client/src/index.ts"],
      "@xcloud/sdk-server": ["./packages/sdk-server/src/index.ts"]
    }
  }
}
